<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="18"
      stylesheets="@estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sistemasaludador.MainController">
    <padding>
        <Insets bottom="28" left="32" right="32" top="28"/>
    </padding>

    <Label styleClass="titulo" text="Sistema Saludador"/>
    <Label styleClass="subtitulo" text="Caso de uso: Solicitar saludo (incluye Pedir datos)"/>
    <Label wrapText="true"
           text="Haz clic en el botón para solicitar un saludo. El sistema te pedirá nombre, edad y hora en formato AM/PM."/>

    <Button fx:id="botonSolicitarSaludo"
            defaultButton="true"
            onAction="#solicitarSaludo"
            styleClass="boton-principal"
            text="Solicitar saludo"/>

    <VBox fx:id="panelDatos" spacing="12" styleClass="tarjeta">
        <Label styleClass="seccion" text="Pedir datos"/>

        <Label text="Nombre"/>
        <TextField fx:id="campoNombre" promptText="Ingresa tu nombre"/>

        <Label text="Edad"/>
        <TextField fx:id="campoEdad" promptText="Ingresa tu edad"/>

        <Label text="Hora (formato AM/PM)"/>
        <HBox spacing="10">
            <ComboBox fx:id="comboHora" maxWidth="Infinity" HBox.hgrow="ALWAYS" promptText="Hora"/>
            <ComboBox fx:id="comboPeriodo" prefWidth="120" promptText="AM/PM"/>
        </HBox>

        <Button fx:id="botonConfirmarDatos"
                maxWidth="Infinity"
                onAction="#confirmarDatos"
                styleClass="boton-secundario"
                text="Confirmar datos"/>
    </VBox>

    <Label fx:id="etiquetaSaludo" styleClass="saludo" wrapText="true"/>
</VBox>
